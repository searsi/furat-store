rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
 function admin() { return request.auth != null && request.auth.uid == '6XWgBHSbD5VgsljI836gcxfX20S2'; }
 match /store/settings { allow read: if true; allow write: if admin(); }
 match /products/{id} { allow read: if true; allow write: if admin(); }
 }
}
